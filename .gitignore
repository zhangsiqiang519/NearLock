# ============================================================
# NearLock 根 .gitignore（macOS + Android 双端）
# ============================================================

# ---------- 通用 ----------
# 本地 Claude Code 环境配置（skill/agent/运行时缓存，不入项目仓库）
.claude/

.DS_Store
*.log
*.tmp
*.swp
.idea/
.vscode/
*.iml

# ---------- macOS / Swift / Xcode ----------
# 构建产物
macos/**/build/
macos/**/DerivedData/
DerivedData/
*.xcuserstate
*.xcscmblueprint

# Xcode 用户级配置（保留 .xcodeproj 本身，仅忽略用户数据）
xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# CocoaPods / Carthage（如后续引入）
macos/**/Pods/
Carthage/Build/

# ---------- Android / Kotlin / Gradle ----------
# 构建产物
android/**/build/
android/build/
.gradle/
android/.gradle/

# 本地配置（含 SDK 路径，不应入库）
android/local.properties

# 签名密钥（敏感信息，禁止入库）
*.jks
*.keystore
android/keystore.properties

# Android Studio
android/.idea/
android/captures/
android/*.iml

# APK / 输出
*.apk
*.aab
android/app/release/

# ---------- Python（.trellis 脚本运行缓存）----------
**/__pycache__/
**/*.pyc
.venv/

# ---------- 环境与密钥 ----------
.env
.env.local
*.local
